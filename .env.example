# Upstash Redis — use the TCP (rediss://) connection string, not the REST URL.
# Found in the Upstash console under "Redis" → your DB → "Connect" → ioredis / TCP.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR-ENDPOINT.upstash.io:6379

# How long an inactive room lives before Redis expires it. The TTL is refreshed
# on every write, so it counts from the last activity. Optional; defaults to 2.
REDIS_TTL_HOURS=2
